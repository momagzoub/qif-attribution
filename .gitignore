.DS_Store
._*
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Large generated artifacts
raw/
build/
dist/
*.zip
data/raw/
data/interim/
data/processed/
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.pdf

# Keep manifest directory tracked via placeholder.
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Documentation: keep only the top-level README in git (exclude all other .md).
*.md
!/README.md
